{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug WebView (Renderer)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/renderer/src",
      "timeout": 60000
    },
    {
      "name": "Debug Rust Backend",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/src-tauri/target/debug/ADOLens.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS": "--remote-debugging-port=9222"
      },
      "preLaunchTask": "cargo build"
    }
  ]
}
